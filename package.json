{
  "name": "cardapio-digital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "preview": "vite preview",
    "gen-icons": "powershell -File scripts/generate-icons.ps1",
    "split-logo": "powershell -ExecutionPolicy Bypass -File scripts/split-logo.ps1",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.mjs",
    "start": "node server-dist/index.mjs",
    "start:local": "node --env-file=.env.local server-dist/index.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^1.30.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^3.2.24",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "esbuild": "^0.21.5"
  },
  "engines": {
    "node": ">=20"
  }
}
