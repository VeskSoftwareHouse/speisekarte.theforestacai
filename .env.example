VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Somente para a função serverless /api/admin-users (nunca prefixar com VITE_,
# senão o Vite embute no bundle do navegador). Pegue em Supabase Dashboard >
# Project Settings > API > "service_role" secret key.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Somente para /api/sumup-create-checkout e /api/sumup-confirm-payment.
# Chave secreta e merchant code em developer.sumup.com > Chaves de API.
SUMUP_API_KEY=sup_sk_sua-chave-secreta
SUMUP_MERCHANT_CODE=SEU-MERCHANT-CODE

# Somente para /api/translate. A equipe cadastra o cardápio em alemão e as
# traduções para os outros 5 idiomas são geradas ao salvar, no Painel da Equipe.
# Chave em console.anthropic.com > API Keys.
# Em branco -> o item é salvo só em alemão (a Mesa já cai no alemão sem tradução).
ANTHROPIC_API_KEY=sk-ant-sua-chave-secreta

# Pagamento por aproximação na maquininha SumUp Solo ao lado do totem
# (Cloud API). Ver scripts/sumup-pair-reader.md para parear o aparelho.
# As duas preenchidas -> a cobrança vai para a maquininha, que acende sozinha.
# Faltando qualquer uma -> cai no checkout hospedado (cartão digitado no navegador).
SUMUP_READER_ID=
SUMUP_AFFILIATE_KEY=
