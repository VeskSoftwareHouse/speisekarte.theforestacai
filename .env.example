VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Somente para a função serverless /api/admin-users (nunca prefixar com VITE_,
# senão o Vite embute no bundle do navegador). Pegue em Supabase Dashboard >
# Project Settings > API > "service_role" secret key.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Somente para /api/sumup-create-checkout e /api/sumup-confirm-payment.
# Chave secreta e merchant code em developer.sumup.com > Chaves de API.
SUMUP_API_KEY=sup_sk_sua-chave-secreta
SUMUP_MERCHANT_CODE=SEU-MERCHANT-CODE

# Pagamento por aproximação (Tap to Pay) no tablet, via Payment Switch da SumUp.
# Peça a Affiliate Key em developer.sumup.com (ou integration@sumup.com) e
# habilite os scopes de Payment Switch na sua conta.
# Preenchida  -> o App da Mesa abre o app da SumUp para o cliente aproximar o cartão.
# Em branco   -> cai no checkout hospedado (cliente digita o cartão no navegador).
# Requer no tablet: Android 11+ com NFC e o app da SumUp instalado e logado.
VITE_SUMUP_AFFILIATE_KEY=
